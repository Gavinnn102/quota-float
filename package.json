{
  "name": "quota-float",
  "private": true,
  "version": "0.1.12-2",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run && npm run test:gnome-extension",
    "test:gnome-extension": "node --experimental-vm-modules --test scripts/gnome-extension.test.mjs",
    "tauri": "tauri",
    "tauri:ubuntu": "tauri build --bundles deb -- --locked && node scripts/normalize-ubuntu-deb.mjs && node scripts/verify-ubuntu-deb.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
